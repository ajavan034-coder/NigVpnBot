# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789

# Notification Channel (optional, leave empty to skip)
CHANNEL_ID=

# 3X-UI Panel Configuration
PANEL_URL=https://your-panel-domain.com:2056/your-path
PANEL_USER=admin
PANEL_PASS=your_panel_password

# Bot Settings
CONFIG_PRICE=3000
FREE_TEST_DAYS=1
CONFIG_MONTHS=30

# Database
DB_PATH=bot_database.db

# Web Panel Configuration
ADMIN_WEB_USER=admin
ADMIN_WEB_PASS=admin
SECRET_KEY=change-this-to-a-random-secret
WEB_PORT=5000